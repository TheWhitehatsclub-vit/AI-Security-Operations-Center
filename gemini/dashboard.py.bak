    --text-secondary: #5a6170;
    --text-tertiary: #8b92a0;
    --orange: #ff6600;
    --orange-light: #fff3eb;
    --orange-border: rgba(255,102,0,0.2);
    --critical: #e53e3e;
    --critical-bg: #fff5f5;
    --high: #dd6b20;
    --high-bg: #fffaf0;
    --medium: #d69e2e;
    --medium-bg: #fffff0;
    --low: #38a169;
    --low-bg: #f0fff4;
    --info: #3182ce;
    --info-bg: #ebf8ff;
    --purple: #805ad5;
    --purple-bg: #faf5ff;
    font-family: 'Inter', system-ui, sans-serif;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
    --shadow-md: 0 2px 8px rgba(0,0,0,0.06);
    --shadow-lg: 0 4px 16px rgba(0,0,0,0.08);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--bg); color: var(--text-primary); overflow-x: hidden; min-height: 100vh; }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #d0d5dd; border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: #b0b5bd; }
  ::selection { background: var(--orange); color: #fff; }

  a { color: var(--orange); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* Top Bar */
  .topbar { display: flex; align-items: center; justify-content: space-between; padding: 0 24px; height: 52px; background: #fff; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
  .logo { display: flex; align-items: center; gap: 10px; }
  .logo-icon { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; color: var(--orange); }
  .logo-icon svg { width: 22px; height: 22px; }
  .logo-text { font-family: 'Fira Code', monospace; font-size: 15px; font-weight: 700; color: var(--text-primary); }
  .logo-text span { color: var(--orange); }
  .logo-sub { font-size: 9px; color: var(--text-tertiary); letter-spacing: 0.08em; text-transform: uppercase; font-family: 'Fira Code', monospace; }
  .topbar-right { display: flex; align-items: center; gap: 20px; }
  .status-indicator { display: flex; align-items: center; gap: 6px; padding: 3px 10px 3px 8px; border-radius: 3px; background: #f0fff4; border: 1px solid #c6f6d5; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #38a169; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .status-dot.live { animation: pulse 2s infinite; }
  .status-dot.warning { background: var(--high); }
  .status-text { font-size: 9px; font-family: 'Fira Code', monospace; color: #38a169; font-weight: 600; letter-spacing: 0.03em; }
  .clock { font-size: 12px; color: var(--text-tertiary); font-family: 'Fira Code', monospace; font-weight: 500; }

  /* Stats Bar */
  .stats-bar { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--border); border-bottom: 1px solid var(--border); }
  .stat-card { background: #fff; padding: 14px 20px; position: relative; }
  .stat-card:hover { background: var(--bg-secondary); }
  .stat-header { display: flex; align-items: center; justify-content: space-between; }
  .stat-icon { display: flex; align-items: center; gap: 8px; color: var(--text-tertiary); }
  .stat-icon svg { width: 16px; height: 16px; }
  .stat-value { font-size: 24px; font-weight: 700; letter-spacing: -0.03em; margin-top: 4px; font-variant-numeric: tabular-nums; }
  .stat-value.total { color: var(--text-primary); }
  .stat-value.critical { color: var(--critical); }
  .stat-value.high { color: var(--high); }
  .stat-value.medium { color: var(--medium); }
  .stat-value.purple { color: var(--purple); }
  .stat-label { font-size: 9px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; font-family: 'Fira Code', monospace; margin-top: 2px; }

  /* Main Layout */
  .main { display: flex; height: calc(100vh - 128px); }
