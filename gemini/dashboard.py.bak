  </div>
</div>

<div class="main">
  <div class="alerts-panel">
    <div class="panel-header">
      <div class="panel-title"><span class="dot"></span> Alert Feed</div>
      <div class="panel-count" id="alertCount">0</div>
    </div>
    <div class="filter-bar" id="filterBar">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="CRITICAL">Critical</button>
      <button class="filter-btn" data-filter="HIGH">High</button>
      <button class="filter-btn" data-filter="MEDIUM">Medium</button>
      <button class="filter-btn" data-filter="LOW">Low</button>
      <div class="filter-divider"></div>
      <button class="filter-btn" data-source="web">Web</button>
      <button class="filter-btn" data-source="network">Network</button>
      <button class="filter-btn" data-source="system">System</button>
      <div class="filter-divider"></div>
      <button class="filter-btn active" id="groupToggle" onclick="toggleGroup(event)">Group</button>
    </div>
    <div id="alertList"></div>
  </div>
  <div class="detail-panel" id="detailPanel">
    <div class="panel-header">
      <div class="panel-title"><span class="dot" style="background:var(--purple)"></span> Analysis</div>
    </div>
    <div class="detail-content" id="detailContent">
      <div class="empty-state">
        <svg class="empty-icon"><use href="#icon-search"/></svg>
        <div class="empty-text">Select an alert</div>
        <div class="empty-sub">Click any alert to view details</div>
      </div>
    </div>
  </div>
</div>

<script>
  const SEVERITY_CLASS = { CRITICAL:'critical', HIGH:'high', MEDIUM:'medium', LOW:'low', INFO:'info' };
let alerts = [], currentFilter = 'all', currentSource = null, selectedAlertId = null, analysisCache = {};
let groupEnabled = true;
const GROUP_SECS = 30;

function groupKey(a) {
  // Group alerts with same rule + source_ip + source within GROUP_SECS
  const ts = a.timestamp ? new Date(a.timestamp).getTime() : 0;
  const bucket = Math.floor(ts / (GROUP_SECS * 1000));
  return `${a.rule_name||''}|${a.source_ip||''}|${a.source||''}|${bucket}`;
}

function clock() {
  document.getElementById('clock').textContent = new Date().toLocaleTimeString('en-US', {hour12:false});
}
setInterval(clock, 1000); clock();

async function fetchStats() {
  try {
    const r = await fetch('/api/stats');
    const s = await r.json();
    document.getElementById('statTotal').textContent = s.total_alerts;
    document.getElementById('statCritical').textContent = s.by_severity.CRITICAL||0;
    document.getElementById('statHigh').textContent = s.by_severity.HIGH||0;
    document.getElementById('statMed').textContent = s.by_severity.MEDIUM||0;
    document.getElementById('statAnalyzed').textContent = s.total_analyzed;
  } catch(e) {}
}
async function fetchAlerts() {
  try {
    const r = await fetch('/api/alerts?limit=100');
    const d = await r.json();
    alerts = d.alerts; renderAlerts();
    document.getElementById('alertCount').textContent = alerts.length;
  } catch(e) {}
}
async function fetchAnalysis() {
  try {
    const r = await fetch('/api/analysis?limit=50');
    const d = await r.json();
    for (const item of d.analysis) if (item.alert_id) analysisCache[item.alert_id] = item;
    if (selectedAlertId && analysisCache[selectedAlertId]) renderDetail(selectedAlertId);
  } catch(e) {}
}

function renderAlerts() {
  const container = document.getElementById('alertList');
  let filtered = currentFilter === 'all' ? alerts : alerts.filter(a => (a.severity||'INFO').toUpperCase() === currentFilter);
  if (currentSource) filtered = filtered.filter(a => a.source === currentSource);
  if (!filtered.length) {
    container.innerHTML = '<div class="empty-state"><svg class="empty-icon"><use href="#icon-search"/></svg><div class="empty-text">No alerts</div><div class="empty-sub">Waiting for incoming threats...</div></div>';
    return;
  }

  // Group identical alerts by rule+source_ip+source+30s bucket
  const groups = {};
  for (const a of filtered) {
    const key = groupKey(a);
    if (!groups[key]) { groups[key] = { ...a, _count: 1, _ids: [a.id] }; }
    else {
      groups[key]._count++;
      groups[key]._ids.push(a.id);
      // Keep highest severity and confidence
      const sevOrder = {CRITICAL:5,HIGH:4,MEDIUM:3,LOW:2,INFO:1};
      if (sevOrder[(a.severity||'').toUpperCase()] > sevOrder[(groups[key].severity||'').toUpperCase()])
        groups[key].severity = a.severity;
      if (typeof a.confidence === 'number' && a.confidence > (groups[key].confidence||0))
        groups[key].confidence = a.confidence;
    }
  }
  const grouped = groupEnabled ? Object.values(groups) : filtered;

  container.innerHTML = grouped.map(a => {
    const sev = (a.severity||'INFO').toUpperCase(), sevClass = SEVERITY_CLASS[sev]||'info';
    const ts = a.timestamp ? new Date(a.timestamp).toLocaleTimeString('en-US',{hour12:false}) : '--';
    const conf = typeof a.confidence === 'number' ? a.confidence.toFixed(3) : a.confidence||'--';
    const src = a.source||'web', srcLabel = src === 'network' ? 'NET' : src === 'system' ? 'SYS' : 'WEB';
    const rlog = a.raw_log&&typeof a.raw_log==='object' ? a.raw_log : {};
    const tool = rlog.tool||'';
    const toolTag = tool ? `<span class="alert-tag tool-tag">${tool}</span>` : '';
    const countBadge = a._count > 1 ? `<span class="alert-tag" style="background:var(--orange);color:#fff;font-weight:700;border:none;">${a._count}x</span>` : '';
    const active = a.id === selectedAlertId ? ' active' : '';
    const clickId = a._ids ? a._ids[0] : a.id;
    return `<div class="alert-card ${sevClass}${active}" onclick="selectAlert('${clickId}')">
      <div class="alert-header">
        <div class="alert-rule">${a.rule_name||'Unknown'}${toolTag} ${countBadge}</div>
        <div style="display:flex;gap:4px;align-items:center;">
          <span class="source-badge source-${src}">${srcLabel}</span>
          <div class="alert-severity severity-${sevClass}">${sev}</div>
        </div>
      </div>
      <div class="alert-body">
        <span class="alert-ip">${a.source_ip||'--'}</span>
        <span class="alert-tag">${a.ttp||'--'}</span>
        <span class="alert-tag">${a.kill_chain||'--'}</span>
        <span class="alert-tag">${a.category||'--'}</span>
        <span class="alert-conf">${conf}</span>
        <span class="alert-time">${ts}</span>
      </div>
      <div class="alert-desc">${a.description||(a.rule_name?a.rule_name+' detected':'')}</div>
    </div>`;
  }).join('');
}

function selectAlert(id) {
  selectedAlertId = id; renderAlerts(); renderDetail(id);
}

function renderDetail(id) {
  const a = alerts.find(x => x.id === id), container = document.getElementById('detailContent');
  if (!a) return;
  const analysis = analysisCache[id], geo = a.geo&&typeof a.geo==='object'?a.geo:{};
  const raw = a.raw_log&&typeof a.raw_log==='object'?a.raw_log:{};
  const ts = a.timestamp ? new Date(a.timestamp).toISOString().replace('T',' ').slice(0,19) : '--';
  const mitreLink = a.ttp ? `https://attack.mitre.org/techniques/${a.ttp}/` : '#';
  const src = a.source || 'web';

  const ctxFields = src === 'network'
    ? [
        ['Alert Type', raw.alert_type||'--'], ['Tool', raw.tool||'--'],
        ['Dest IP', raw.dst_ip||'--'], ['Dest Port', raw.dst_port||'--'],
        ['State', raw.state||'--'], ['Scan Type', raw.scan_type||'--'],
        ['Port Count', raw.port_count||'--'], ['SYN Count', raw.syn_count||'--'],
        ['EST Count', raw.est_count||'--'], ['Ratio', raw.ratio||'--'],
        ['Detail', (raw.detail||'--').slice(0,40)], ['IP', raw.ip||'--'],
        ['MAC', raw.mac||'--'], ['Prev MAC', raw.previous_mac||'--'],
        ['Curr MAC', raw.current_mac||'--'],
      ].filter(([_,v]) => v && v !== '--')
    : src === 'system'
    ? [
        ['Message', (raw.message||'--').slice(0,60)], ['Unit', raw.unit||'--'],
        ['Hostname', raw.hostname||'--'],
      ].filter(([_,v]) => v && v !== '--')
    : [
        ['Method', raw.method||'--'], ['Path', (raw.path||'--').slice(0,50)],
        ['Status', raw.status||'--'], ['UA', (raw.user_agent||'--').slice(0,30)],
        ['Query', (raw.query||'--').slice(0,50)],
        ['Body', (raw.body||'').slice(0,80)||'--'],
      ].filter(([_,v]) => v && v !== '--');
  let html = `
    <div class="detail-section">
      <div class="detail-section-title">Alert Details</div>
      <div class="detail-grid">
        <div class="detail-field"><span class="detail-label">Source</span><span class="detail-value">${src.charAt(0).toUpperCase()+src.slice(1)}</span></div>
        <div class="detail-field"><span class="detail-label">Rule</span><span class="detail-value">${a.rule_name||'--'}</span></div>
        <div class="detail-field"><span class="detail-label">Severity</span><span class="detail-value" style="color:${sevColor(a.severity)};font-weight:700">${(a.severity||'--').toUpperCase()}</span></div>
        <div class="detail-field"><span class="detail-label">Confidence</span><span class="detail-value mono">${typeof a.confidence==='number'?(a.confidence*100).toFixed(1)+'%':'--'}</span></div>
        <div class="detail-field"><span class="detail-label">Kill Chain</span><span class="detail-value mono">${a.kill_chain||'--'}</span></div>
        <div class="detail-field"><span class="detail-label">Category</span><span class="detail-value">${a.category||'--'}</span></div>
        <div class="detail-field"><span class="detail-label">Timestamp</span><span class="detail-value mono">${ts}</span></div>
        <div class="detail-field"><span class="detail-label">Source IP</span><span class="detail-value mono">${a.source_ip||'--'}</span></div>
      </div>
      ${a.ttp?`<div class="mitre-link"><svg><use href="#icon-hash"/></svg><a href="${mitreLink}" target="_blank" style="color:inherit;text-decoration:none;">MITRE ATT&CK: ${a.ttp}</a></div>`:''}
      ${raw.tool?`<div style="padding:0 12px 8px;"><span class="alert-tag tool-tag">${raw.tool}</span></div>`:''}
    </div>
    ${ctxFields.length?`<div class="detail-section">
      <div class="detail-section-title">${src==='network'?'Network Context':src==='system'?'System Context':'Request Context'}</div>
      <div class="detail-grid">${ctxFields.map(([l,v])=>`<div class="detail-field"><span class="detail-label">${l}</span><span class="detail-value mono" style="font-size:9px">${v}</span></div>`).join('')}</div>
    </div>`:''}
    <div class="detail-section">
      <div class="detail-section-title">Matched Value</div>
      <div class="matched-box">${(a.matched_value||'--').slice(0,150)}</div>
    </div>
    ${geo.country||geo.city?`
    <div class="detail-section">
      <div class="detail-section-title">Geo Location</div>
      <div class="detail-grid">
        <div class="detail-field"><span class="detail-label">Country</span><span class="detail-value">${geo.country||'--'}</span></div>
        <div class="detail-field"><span class="detail-label">City</span><span class="detail-value">${geo.city||'--'}</span></div>
        ${geo.asn?`<div class="detail-field"><span class="detail-label">ASN</span><span class="detail-value mono">${geo.asn}</span></div>`:''}
      </div>
    </div>`:''}`;

  if (analysis && analysis.analysis) {
    const an = analysis.analysis;
    const fp = an.false_positive_likelihood;
    let fpColor = '#38a169';
    if (fp > 70) fpColor = '#e53e3e'; else if (fp > 30) fpColor = '#dd6b20';
    html += `<div class="analysis-card">
      <div class="gemini-badge"><svg><use href="#icon-bolt"/></svg> Gemini AI</div>
      ${an.summary?`<div class="analysis-summary">${an.summary}</div>`:''}
      ${an.attack_explanation?`<div class="analysis-explanation">${an.attack_explanation}</div>`:''}
      <div class="analysis-row"><span style="font-size:9px;color:var(--text-tertiary);font-family:'Fira Code',monospace;">True Severity:</span><span style="font-weight:700;font-size:13px;color:${sevColor(an.true_severity)}">${an.true_severity||'--'}</span></div>
      <div class="analysis-row" style="font-size:11px;color:var(--text-secondary)">False Positive Likelihood: <span style="color:${fpColor};font-weight:700;margin-left:4px">${fp!==undefined?fp+'%':'--'}</span></div>
      ${an.recommended_actions&&an.recommended_actions.length?`
      <div style="font-size:9px;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.05em;font-family:'Fira Code',monospace;margin-bottom:5px;">Recommended Actions</div>
      <ul class="analysis-actions">${an.recommended_actions.map(a=>`<li>${a}</li>`).join('')}</ul>`:''}
      ${an.analyst_notes?`<div style="margin-top:8px;padding:8px;background:var(--bg-secondary);border:1px solid var(--border-light);font-size:10px;color:var(--text-secondary);line-height:1.4;border-radius:2px;"><span style="color:var(--orange);font-family:'Fira Code',monospace;">// notes</span><br>${an.analyst_notes}</div>`:''}
    </div>`;
  } else {
    html += `<div class="waiting-box"><div class="waiting-box-text">Waiting for Gemini analysis...</div></div>`;
  }
  container.innerHTML = html;
}

function sevColor(s) {
  const map = {CRITICAL:'var(--critical)',HIGH:'var(--high)',MEDIUM:'var(--medium)',LOW:'var(--low)',INFO:'var(--info)'};
  return map[(s||'').toUpperCase()] || 'var(--text-primary)';
}

function toggleGroup(e) {
  if (e) e.stopPropagation();
  groupEnabled = !groupEnabled;
  document.getElementById('groupToggle').classList.toggle('active');
  renderAlerts();
}

document.getElementById('filterBar').addEventListener('click', e => {
  const btn = e.target.closest('.filter-btn');
  if (!btn) return;
  if (btn.dataset.source) {
    currentSource = currentSource === btn.dataset.source ? null : btn.dataset.source;
    document.querySelectorAll('.filter-btn[data-source]').forEach(b => b.classList.remove('active'));
    if (currentSource) btn.classList.add('active');
  } else {
    currentSource = null;
    document.querySelectorAll('.filter-btn[data-source]').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active'); currentFilter = btn.dataset.filter;
  }
  renderAlerts();
});

let source=null;
function connectSSE() {
  source = new EventSource('/api/stream');
  source.onmessage = e => {
    try {
      const msg = JSON.parse(e.data);
      if (msg.type === 'alert') {
        if (alerts.findIndex(a => a.id === msg.data.id) === -1) {
          alerts.unshift(msg.data);
          if (alerts.length > 200) alerts.pop();
          fetchStats(); renderAlerts();
          document.getElementById('alertCount').textContent = alerts.length;
        }
      }
    } catch(e) {}
  };
  source.onerror = () => {
    document.getElementById('statusDot').className = 'status-dot warning';
    document.getElementById('statusText').textContent = 'DISCONNECTED';
    source.close(); setTimeout(connectSSE, 3000);
  };
  source.onopen = () => {
    document.getElementById('statusDot').className = 'status-dot live';
    document.getElementById('statusText').textContent = 'STREAMING';
  };
}

fetchStats(); fetchAlerts(); fetchAnalysis(); connectSSE();
setInterval(fetchAnalysis, 5000); setInterval(fetchStats, 10000);
</script>
</body>
</html>"""

if __name__ == "__main__":
    print("=" * 60)
    print("  NEURALOPS — SOC Dashboard")
    print("  http://0.0.0.0:8002")
    print("=" * 60)
    uvicorn.run(app, host="0.0.0.0", port=8002)
