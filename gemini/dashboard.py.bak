  /* Panel Headers */
  .panel-header { padding: 10px 16px; background: #fff; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; }
  .panel-title { font-family: 'Fira Code', monospace; font-size: 10px; color: var(--text-secondary); letter-spacing: 0.04em; text-transform: uppercase; display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .panel-title .dot { width: 6px; height: 6px; border-radius: 1px; background: var(--orange); }
  .panel-count { font-family: 'Fira Code', monospace; font-size: 10px; color: var(--text-tertiary); background: var(--bg-secondary); padding: 2px 8px; border-radius: 3px; font-weight: 500; }

  /* Filter Bar */
  .filter-bar { display: flex; gap: 4px; padding: 8px 16px; background: #fff; border-bottom: 1px solid var(--border); flex-wrap: wrap; align-items: center; }
